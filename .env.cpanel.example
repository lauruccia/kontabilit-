APP_NAME="Gruppo Kosmos Client Hub"
APP_ENV=production
APP_KEY=base64:INSERISCI_APP_KEY_DA_ENV_LOCALE
APP_DEBUG=false
APP_URL=https://kosmopolis.it

APP_LOCALE=it
APP_FALLBACK_LOCALE=it
APP_FAKER_LOCALE=it_IT

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_nome_database
DB_USERNAME=cpaneluser_nome_utente
DB_PASSWORD=password_database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_HOST=mail.kosmopolis.it
MAIL_PORT=465
MAIL_USERNAME=noreply@kosmopolis.it
MAIL_PASSWORD=password_email
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=noreply@kosmopolis.it
MAIL_FROM_NAME="Gruppo Kosmos"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

DEPLOY_TOKEN=cambia-questa-stringa-lunga

VITE_APP_NAME="${APP_NAME}"
